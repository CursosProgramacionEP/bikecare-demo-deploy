# Plantilla de secretos locales de BikeCare.
# Copia este archivo y ponlo en .env y reemplaza los valores reales.
# el archivo .env esta en .gitignore: nunca se sube al repo

# Base de datos MySQL
DB_PASSWORD=cambia-esta-contrasenia

# Cuenta de correo para la recuperacion de contrasenia (opcional).
# Sigue funcionando la aplicacion, pero ya no envia un correos
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail

# API Key de Google AI Studio para el Diagnóstico IA
GEMINI_API_KEY=tu-api-key-de-gemini